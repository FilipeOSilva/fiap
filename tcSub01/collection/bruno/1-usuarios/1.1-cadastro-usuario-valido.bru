meta {
  name: 1.1 Cadastro de usuário válido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Maria Silva",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "role": "USUARIO"
  }
}

script:post-response {
  bru.setVar("userId", res.getBody().id);
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Usuário criado com id", function() {
    expect(res.getBody().id).to.be.a("number");
  });
  test("Papel USUARIO", function() {
    expect(res.getBody().role).to.equal("USUARIO");
  });
}
