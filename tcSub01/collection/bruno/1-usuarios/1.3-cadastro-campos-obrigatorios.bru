meta {
  name: 1.3 Cadastro inválido - campos obrigatórios ausentes
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("Status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Retorna erros de campo", function() {
    expect(res.getBody().fieldErrors).to.be.an("object");
  });
  test("Aponta name e email", function() {
    expect(res.getBody().fieldErrors).to.have.property("name");
    expect(res.getBody().fieldErrors).to.have.property("email");
  });
}
