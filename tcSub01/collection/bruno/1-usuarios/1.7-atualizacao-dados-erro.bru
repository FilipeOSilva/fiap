meta {
  name: 1.7 Atualização de dados - erro de validação
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "",
    "email": "email-invalido"
  }
}

tests {
  test("Status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Retorna fieldErrors", function() {
    expect(res.getBody().fieldErrors).to.be.an("object");
  });
}
