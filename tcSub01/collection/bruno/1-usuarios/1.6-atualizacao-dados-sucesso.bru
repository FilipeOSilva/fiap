meta {
  name: 1.6 Atualização de dados - sucesso
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Maria Souza",
    "email": "{{updatedEmail}}"
  }
}

script:post-response {
  bru.setVar("userEmail", res.getBody().email);
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Nome atualizado", function() {
    expect(res.getBody().name).to.equal("Maria Souza");
  });
  test("E-mail atualizado", function() {
    expect(res.getBody().email).to.equal(bru.getVar("updatedEmail"));
  });
}
