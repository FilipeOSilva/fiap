meta {
  name: 3.6 Cancelamento por administrador
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/reservations/{{reservationId}}/cancel
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Reserva cancelada", function() {
    expect(res.getBody().status).to.equal("CANCELADA");
  });
}
