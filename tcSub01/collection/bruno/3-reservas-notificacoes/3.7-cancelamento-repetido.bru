meta {
  name: 3.7 Cancelamento repetido - erro
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/reservations/{{reservationId}}/cancel
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("Status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Mensagem de reserva já cancelada", function() {
    expect(res.getBody().message).to.include("cancelada");
  });
}
