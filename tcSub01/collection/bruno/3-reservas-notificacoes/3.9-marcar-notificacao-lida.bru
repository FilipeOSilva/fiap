meta {
  name: 3.9 Marcar notificação como lida
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/notifications/{{notificationId}}/read
  body: none
  auth: none
}

headers {
  X-User-Id: {{userId}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Notificação lida", function() {
    expect(res.getBody().read).to.equal(true);
  });
}
